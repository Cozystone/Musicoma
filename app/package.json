{
  "name": "musicoma",
  "productName": "Musicoma",
  "version": "0.4.1",
  "description": "Musicoma DAW desktop shell",
  "author": "Musicoma",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win nsis",
    "build:runtime": "powershell -NoProfile -ExecutionPolicy Bypass -File runtime/build_runtime.ps1",
    "dist:full": "npm run build:runtime && npm run dist"
  },
  "devDependencies": {
    "electron": "44.4.5",
    "electron-builder": "26.16.1"
  },
  "build": {
    "appId": "com.musicoma.app",
    "productName": "Musicoma",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "splash.html",
      "firstrun.html",
      "firstrun-preload.js",
      "listen.js",
      "build/icon.ico",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Musicoma",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "Musicoma Setup ${version}.exe",
      "include": "build/installer.nsh",
      "license": "../LICENSE"
    },
    "extraResources": [
      {
        "from": "../musicoma",
        "to": "musicoma/musicoma",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc",
          "!_mc_old.py"
        ]
      },
      {
        "from": "../ui",
        "to": "musicoma/ui",
        "filter": [
          "**/*",
          "!**/__pycache__",
          "!**/__pycache__/**",
          "!**/*.pyc"
        ]
      },
      {
        "from": "../core/build",
        "to": "musicoma/core/build",
        "filter": [
          "musicoma-engine.exe"
        ]
      },
      {
        "from": "runtime",
        "to": "musicoma/setup",
        "filter": [
          "requirements-core.txt",
          "requirements-ai.txt",
          "ai/**/*"
        ]
      },
      {
        "from": "THIRD_PARTY_NOTICES.md",
        "to": "musicoma/THIRD_PARTY_NOTICES.md"
      },
      {
        "from": "runtime/dist/python",
        "to": "runtime/python",
        "filter": [
          "**/*"
        ]
      },
      {
        "from": "runtime/dist/uv.exe",
        "to": "runtime/uv.exe"
      },
      {
        "from": "../LICENSE",
        "to": "musicoma/LICENSE"
      },
      {
        "from": "../LICENSING.md",
        "to": "musicoma/LICENSING.md"
      }
    ],
    "compression": "normal"
  },
  "license": "AGPL-3.0-only"
}
